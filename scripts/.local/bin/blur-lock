#!/usr/bin/env bash
# Lock the screen over a blurred snapshot of the current desktop.
# ffmpeg grabs an X11 frame, blurs it, and i3lock displays the raw RGB. Writing
# raw instead of PNG skips the slow PNG encode/decode (delay: ~400ms -> ~200ms).
# No ImageMagick or betterlockscreen required.
set -u

res="$(xrandr --current 2>/dev/null | grep -m1 '\*' | awk '{print $1}')"
res="${res:-1920x1080}"

raw="$(mktemp)"
trap 'rm -f "$raw"' EXIT

if ffmpeg -loglevel error -y \
      -f x11grab -video_size "$res" -i "$DISPLAY" -frames:v 1 \
      -vf "gblur=sigma=20,eq=brightness=-0.06,format=rgb24" \
      -f rawvideo -pix_fmt rgb24 "$raw"; then
    i3lock --nofork --no-unlock-indicator --ignore-empty-password \
        --raw "${res}:rgb" --image "$raw"
else
    # If capture/blur fails, still lock with a solid color.
    i3lock --nofork --no-unlock-indicator --ignore-empty-password --color=000000
fi
